# ---------------------------------------------------------------------------
# GovNavigator Ghana - backend configuration
# Copy to .env and edit. NEVER commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development

# --- database --------------------------------------------------------------
# Fastest start, no database server and no accounts. Everything works: same
# services, same citations, same evaluation score. The test suite runs on it.
DATABASE_URL=sqlite:///./govnav.db

# Deployment target: managed Postgres with the pgvector extension. Run
# CREATE EXTENSION IF NOT EXISTS vector; on it once, then uncomment ONE of
# these and comment out the sqlite line above.
#
# NOTE the "+psycopg" in the scheme. Neon and Supabase hand you a URL starting
# "postgresql://" - you must rewrite it, or SQLAlchemy looks for a driver that
# is not installed.
#
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@HOST:5432/postgres

# --- security --------------------------------------------------------------
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-not-a-secret-change-before-deploying-anywhere
ADMIN_EMAIL=curator@govnavigator.local
ADMIN_PASSWORD=change-me-before-you-deploy
CORS_ORIGINS=http://localhost:3000

# --- AI providers ----------------------------------------------------------
# Optional in the sense that the app runs correctly without one: answers still
# come from verified sources with citations. What a model adds is understanding
# of the QUESTION - reading "for my brother who is abroad" as a condition, and
# answering it directly above the checklist. See docs/AI_WORKFLOW.md.
#
# Gemini has a free tier and needs no card: https://aistudio.google.com/apikey
# After setting a key, check it actually works:
#     python -m app.scripts.check_llm
LLM_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Leave blank to use the provider default (currently gemini-3.5-flash).
# Model ids ARE retired - if check_llm reports a 404, pin a current one from
# https://ai.google.dev/gemini-api/docs/models
#   gemini-3.5-flash-lite  cheapest and fastest
#   gemini-3.5-flash       the default: good balance
#   gemini-3.7-flash       most capable, use if conditions are misread
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20

# --- embeddings ------------------------------------------------------------
# SEPARATE from the chat model above, and left local on purpose. The local
# embedder is instant, offline, and scores 100% on the golden set - while a
# remote one adds a network call to EVERY question and must be re-seeded if you
# ever change it. Recommended: leave this alone and let the model do the
# understanding, not the searching.
#
# To use remote embeddings anyway, name the provider and re-run seed --reset:
#   EMBEDDING_PROVIDER=gemini
#   EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=

# --- tuning ----------------------------------------------------------------
# Raising the floor makes the product quieter and safer; lowering it makes it
# chattier and more dangerous. Re-run the eval after changing it.
RELEVANCE_FLOOR=0.45
AMBIGUITY_MARGIN=0.04
FRESHNESS_WARN_DAYS=120
RATE_LIMIT_PER_MINUTE=20
